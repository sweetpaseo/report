{
  "manifest_version": 3,
  "name": "ACS Social Media Assistant",
  "version": "1.0.1",
  "description": "Asisten analitik dan optimasi konten media sosial terintegrasi AI Creative Studio (ACS).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://localhost/*",
    "*://localhost:*/*",
    "*://127.0.0.1/*",
    "*://127.0.0.1:*/*",
    "*://report.erihome.id/*",
    "*://*.erihome.id/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ACS Social Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content-scripts/instagram-extractor.js",
        "content-scripts/floating-copilot.js"
      ],
      "css": [
        "inpage-widget/widget.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
